# Database — Neon Postgres.
DATABASE_URL="postgresql://user:password@host/db?schema=public"
# The direct (non-pgbouncer) connection string — migrations need this;
# pooled connections in transaction mode can't hold the advisory lock
# `prisma migrate deploy` takes. On Vercel + Neon this is set automatically
# by scripts/vercel-build.sh's fallback; set it explicitly for any other
# host. Same value as DATABASE_URL is fine for a local, unpooled Postgres.
DIRECT_DATABASE_URL="postgresql://user:password@host/db?schema=public"

# Public base URL — used to build shareable pet-page links and Open Graph
# image URLs. Set to the real contest subdomain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments -----------------------------------------------------------
# "mock" (default) needs nothing else below and works with zero setup —
# use it for local dev and demos. "stripe" needs STRIPE_SECRET_KEY.
# BBMS isn't wired in yet — see DECISIONS.md.
PAYMENT_PROVIDER="mock"

# Signs the mock checkout session token — any random string works locally;
# generate a real random value for anything deployed. Required whenever
# PAYMENT_PROVIDER=mock.
MOCK_PAYMENT_SECRET="change-me-to-a-random-string"

# Stripe test-mode secret key (sk_test_...). Required when
# PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=""

# --- Email ----------------------------------------------------------------
# "console" (default) logs emails instead of sending — safe for dev/CI.
# "resend" needs RESEND_API_KEY and EMAIL_FROM.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Second Chance Pet Adoptions <contest@secondchancenc.org>"

# --- Image storage ---------------------------------------------------------
# Used for pet photo uploads. "local" (default) writes to public/uploads —
# fine for dev, but files don't survive a redeploy on Vercel, so set this to
# "r2" or "bunny" before real entries go live.
STORAGE_PROVIDER="local"

# Cloudflare R2 (S3-compatible). Required when STORAGE_PROVIDER=r2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Bunny.net Storage (not S3-compatible — its own REST API). Required when
# STORAGE_PROVIDER=bunny. BUNNY_PULL_ZONE_URL must be the Pull Zone (CDN)
# hostname connected to the Storage Zone, e.g. "https://my-zone.b-cdn.net" —
# not the storage API host — or uploads will succeed but photoUrl won't load.
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_API_KEY=""
BUNNY_PULL_ZONE_URL=""
# Optional — a regional storage endpoint (e.g. "ny", "la", "sg", "syd",
# "uk", "se", "br", "jh"); omit to use Bunny's default main endpoint.
BUNNY_STORAGE_REGION=""

# --- Admin auth -------------------------------------------------------------
# Signs admin session cookies. Required before the admin moderation queue
# can be used — generate a real random value for anything deployed.
ADMIN_SESSION_SECRET="change-me-to-a-random-string"

# There's no signup flow by design. Setting these creates/updates the one
# AdminUser on every build (scripts/create-admin.ts, run from
# scripts/vercel-build.sh) — safe to leave set permanently; changing
# ADMIN_PASSWORD and redeploying just resets it. Leave both unset to skip
# admin bootstrap entirely (e.g. before the moderation queue is needed).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
