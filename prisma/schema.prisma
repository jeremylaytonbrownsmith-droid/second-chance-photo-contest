// Second Chance Pet Adoptions — Photo Contest
// See CLAUDE.md for hard rules: integer cents, no card storage, every
// payment event logged, nothing hard deleted, payment processor behind an
// adapter interface.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pgbouncer) connection — pooled
  // connections in transaction mode don't support the session-level
  // advisory lock `prisma migrate deploy` takes, which times out with
  // P1002 otherwise. Only `prisma migrate`/`introspect` use this; the
  // runtime query engine still uses the pooled `url` above.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EntryStatus {
  PENDING // awaiting payment or moderation
  APPROVED // live in the public gallery
  REJECTED // moderator rejected — stays in the system, never deleted
  DISQUALIFIED // was live, then pulled — e.g. fraud, rule violation
}

// OTHER covers anything beyond cat/dog (the client has run years with
// fish, birds, even a groundhog and horses) without needing a migration
// every time a new animal type shows up — this just needs to split the
// gallery/leaderboard/moderation queue into a few buckets, not model
// taxonomy.
enum AnimalSpecies {
  DOG
  CAT
  OTHER
}

enum TransactionType {
  ENTRY_FEE
  VOTE_PURCHASE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProcessorName {
  MOCK
  STRIPE
  BBMS
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
}

enum VerificationPurpose {
  FREE_VOTE
  ENTRY_EMAIL
}

// Two tiers, matching the client's own description of her sponsor roster
// ("three bigger sponsors and six smaller sponsors") — not a generic
// configurable-tiers system, since that's what she's actually run.
enum SponsorTier {
  FEATURED
  SUPPORTER
}

// ---------------------------------------------------------------------------
// Contest configuration — a row per contest instance (this year's contest,
// next year's contest, etc.), not a single global settings blob, so past
// contests stay queryable on their own terms.
// ---------------------------------------------------------------------------

model Contest {
  id   String @id @default(cuid())
  name String

  startsAt DateTime
  endsAt   DateTime

  entryFeeCents    Int  @default(1000) // $10, admin configurable
  votePriceCents   Int  @default(100) // $1/vote, admin configurable
  // Vote packages as [{ "votes": 5, "priceCents": 500 }, ...] plus a
  // custom-amount option handled in the UI — flexible without a migration
  // every time the packages change.
  votePackagesJson Json @default("[{\"votes\":5},{\"votes\":10},{\"votes\":25},{\"votes\":50},{\"votes\":100}]")

  goalCents Int @default(5000000) // $50,000, matches the prior GoGo result

  // No-purchase-necessary safeguard — see CLAUDE.md rule 7/8. Defaults ON;
  // do not flip this off without a logged, deliberate, legally-reviewed
  // decision.
  freeVoteEnabled Boolean @default(true)

  roundsEnabled    Boolean @default(false)
  // e.g. [{ "roundNumber": 1, "advanceCount": 50, "endsAt": "..." }]
  roundsConfigJson Json?

  moderationEnabled Boolean @default(true)

  prizeText  String? @db.Text
  prizeImage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries      Entry[]
  transactions Transaction[]
  freeVotes    FreeVoteLog[]
  sponsors     Sponsor[]

  @@map("contests")
}

// ---------------------------------------------------------------------------
// Entries
// ---------------------------------------------------------------------------

model Entry {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  petName    String
  caption    String @db.Text
  ownerName  String
  ownerEmail String

  // Nullable so entries that predate this field aren't forced to a wrong
  // guess — every entry submitted through the form going forward always
  // sets one. rescueSource is always optional (some pets weren't adopted).
  species      AnimalSpecies?
  rescueSource String?

  photoUrl String // Cloudflare R2 object URL
  slug     String // URL-safe, unique per contest — /pet/{slug}

  status             EntryStatus @default(PENDING)
  moderationNote     String?
  disqualifiedReason String?

  // Denormalized vote count for fast leaderboard reads. Source of truth is
  // still the sum of successful VOTE_PURCHASE transactions + FreeVoteLog
  // rows for this entry — this column is a cache, recomputed on every vote,
  // never hand-edited.
  voteCount Int @default(0)

  eliminated   Boolean   @default(false)
  eliminatedAt DateTime?

  // Separate from `status` on purpose — an entry can be APPROVED (live in
  // the gallery) well before an admin has reviewed it for social sharing.
  // Described directly on the call: an admin "accept/reject" step before
  // the share buttons + QR code go live on the pet's page, distinct from
  // the moderation accept/reject that gets it into the gallery at all.
  shareApproved Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  transactions Transaction[]
  freeVotes    FreeVoteLog[]
  fraudFlags   FraudFlag[]

  @@unique([contestId, slug])
  @@index([contestId, status])
  @@index([contestId, voteCount])
  @@index([contestId, status, species])
  @@map("entries")
}

// ---------------------------------------------------------------------------
// Money — every payment event, success or failure, lives here. This is the
// nonprofit's donor/tax record as much as it is app state.
// ---------------------------------------------------------------------------

model Transaction {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])
  entryId   String?
  entry     Entry?  @relation(fields: [entryId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amountCents  Int
  voteQuantity Int? // set for VOTE_PURCHASE

  processor    PaymentProcessorName
  processorRef String? // checkout session / charge id from the processor

  // Donor record fields — needed for the Raiser's Edge NXT export and
  // year-end tax documentation, not just for running the checkout.
  donorName    String
  donorEmail   String
  donorAddress String?
  donorCity    String?
  donorState   String?
  donorZip     String?

  refundedAt   DateTime?
  refundReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fraudFlags FraudFlag[]

  @@index([contestId, status])
  @@index([entryId])
  @@index([donorEmail])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Free daily vote — the no-purchase-necessary safeguard. One free vote per
// verified email per entry per day. See CLAUDE.md rule 7 before touching
// this model's behavior.
// ---------------------------------------------------------------------------

model FreeVoteLog {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])
  entryId   String
  entry     Entry   @relation(fields: [entryId], references: [id])

  email   String
  votedOn DateTime @db.Date // calendar day, for the one-per-day constraint

  createdAt DateTime @default(now())

  @@unique([contestId, entryId, email, votedOn])
  @@map("free_vote_logs")
}

// Email verification for the free vote (and available for entry-email
// confirmation later) — short-lived code, not a password.
model EmailVerification {
  id      String              @id @default(cuid())
  email   String
  code    String
  purpose VerificationPurpose

  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@map("email_verifications")
}

// ---------------------------------------------------------------------------
// Sponsors — directly from the call: she wants a place to put sponsor
// logos ("up at the top, there's still some blank space... down at the
// bottom... a sponsored area"), split FEATURED/SUPPORTER to match how she
// already runs it ("three bigger sponsors and six smaller sponsors").
// Soft-deletable like everything else (CLAUDE.md rule 4) — a sponsor who
// drops out one year may come back the next, and the record of who
// sponsored when shouldn't just vanish.
// ---------------------------------------------------------------------------

model Sponsor {
  id        String  @id @default(cuid())
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  name    String
  logoUrl String
  linkUrl String? // sponsor's own site, if they want the logo clickable

  tier      SponsorTier @default(SUPPORTER)
  sortOrder Int         @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  voidedAt   DateTime?
  voidReason String?

  @@index([contestId, tier, sortOrder])
  @@map("sponsors")
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(MODERATOR)

  // Login brute-force protection — incremented on each failed password
  // check, reset on success. lockedUntil blocks further attempts (even
  // with the correct password) until it passes, without needing a
  // separate rate-limit store (Vercel's serverless functions don't share
  // memory between invocations, so this has to live in the database).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  voidedAt  DateTime?

  auditLogs AdminAuditLog[]
  passkeys  AdminPasskey[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Passkeys (WebAuthn) — the second factor. One AdminUser can register more
// than one (e.g. phone + laptop). credentialId is what the browser sends
// back to identify which key signed a login; publicKey/counter are what
// verifyAuthenticationResponse() needs to check that signature and guard
// against a cloned authenticator (counter must only ever increase).
// ---------------------------------------------------------------------------

model AdminPasskey {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id])
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  deviceLabel  String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("admin_passkeys")
}

// ---------------------------------------------------------------------------
// Admin audit log — who did what, when. Covers login attempts (including
// failed ones, so a brute-force run is visible after the fact) and every
// moderation decision. adminUserId is nullable because a failed login with
// an email that doesn't match any admin still needs to be logged, and
// there's no AdminUser row to point it at.
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  adminEmail  String
  action      String
  targetType  String?
  targetId    String?
  detail      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ---------------------------------------------------------------------------
// Visit tracking — answers the admin dashboard's "how many people have
// been on the site today" without wiring up the Google Analytics Data API
// (which needs client-supplied credentials we don't have). One row per
// (day, anonymous visitor cookie) — the unique constraint itself is the
// dedup, so repeat visits the same day are a no-op upsert, not double
// counted. No IP, no user agent, no page path — just enough to count
// people, not to profile them.
// ---------------------------------------------------------------------------

model PageVisit {
  id        String   @id @default(cuid())
  visitorId String
  day       String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())

  @@unique([day, visitorId])
  @@index([day])
  @@map("page_visits")
}

// ---------------------------------------------------------------------------
// Fraud tooling — flags for review, not automatic blocks (a human decides).
// ---------------------------------------------------------------------------

model FraudFlag {
  id            String       @id @default(cuid())
  entryId       String?
  entry         Entry?       @relation(fields: [entryId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  reason     String
  resolvedAt DateTime?
  resolution String?

  createdAt DateTime @default(now())

  @@map("fraud_flags")
}
